---
import Layout from '../layouts/Layout.astro';
import TrustSignals from '../components/TrustSignals.astro';
import OptimizedImage from '../components/OptimizedImage.astro';
import GoogleReviewsWidget from '../components/GoogleReviewsWidget.astro';
import TransformationsCarousel from '../components/TransformationsCarousel.astro';
import { business } from '../data/business';
import { getService } from '../data/services';

const services = [
  {
    ...getService('keratin-treatments'),
    icon: "sparkles",
  },
  {
    ...getService('womens-cut-finish'),
    icon: "scissors",
  },
  {
    ...getService('partial-foils'),
    icon: "scissors",
  },
  {
    ...getService('half-head-highlights'),
    icon: "scissors",
  },
  {
    ...getService('full-head-highlights'),
    icon: "scissors",
  },
  {
    ...getService('permanent-tint-touch-up'),
    icon: "scissors",
  },
];

const galleryImages = [
  {
    src: "/images/optimized/balayage-transformation_480q60.webp",
    alt: "Professional balayage hair transformation showing natural-looking highlights and color depth"
  },
  {
    src: "/images/optimized/highlights-before-after_480.webp",
    alt: "Before and after hair highlights transformation by Hair By Melissa showing dimensional color"
  },
  {
    src: "/images/optimized/melissa-professional_480q60.webp",
    alt: "Melissa professional hair stylist at Hair By Melissa salon in Kaukapakapa"
  },
  {
    src: "/images/optimized/salon-interior_480q60.webp",
    alt: "Hair By Melissa salon interior showing professional styling station and modern decor"
  }
];

const homeFaqs = [
  {
    question: "How should I prepare for my appointment, and what aftercare helps my colour or smoothing last longer?",
    answer: "Before your appointment, come in with your hair clean, dry, and as close to natural as possible. Avoid heavy styling products and don't use a straightener or curling iron right beforehand. Make a note of any inspiration photos or specific goals you have for your hair, as these are helpful to share during your consultation. After your service, it's best to use salon-recommended, sulfate-free shampoos and conditioners to protect your colour or smoothing treatment. Try to wash your hair less often if possible and use lukewarm water instead of hot. For keratin treatments, don't wash your hair for at least 72 hours and avoid tying it up during that time. Always use a heat protectant if you use hot tools, and book in for regular trims and any suggested toners or touch-ups. Following these tips helps keep your colour vibrant and your hair smoother for longer.",
  },
  {
    question: "Can I book online, or do I need to call or email to make an appointment?",
    answer: "You can book your appointment online any time. It's quick and easy. If you'd rather talk things through or have specific questions, you can also call 0274 799 320 or email. All options work, so just use whatever's easiest for you.",
  },
  {
    question: "Do you offer a consultation to help choose the right colour and cut for my hair type and lifestyle?",
    answer: "Every service includes a thorough consultation before we start. We talk about your hair type, face shape, and what style or colour will really suit your day-to-day life. All your questions about colouring, cutting, or treatments get answered, and you'll know exactly what to expect. It's important to make sure you feel confident about your options before we do anything.",
  },
  {
    question: "Do you offer kids' haircuts, and what ages do you work with?",
    answer: "Kids' haircuts are available, and I'm happy to work with children of any age. The approach is gentle and unhurried, focusing on making the experience comfortable for younger clients. If you have a child who's nervous or prefers extra time, just let me know so I can make sure we go at their pace.",
  },
  {
    question: "Do you offer foil highlights, and what are the starting prices?",
    answer: "You can get foil highlights here, including partial foils starting at $90, half head highlights from $140, and full head highlights from $180. Each option is tailored to fit your look and lifestyle, with a detailed consultation before we start so you know what to expect and how it'll suit your hair type.",
  },
  {
    question: "How does balayage work, and what maintenance should I expect as it grows out?",
    answer: "Balayage is a hand-painting technique where the colour is applied in soft, sweeping sections for a natural, sun-kissed look. Before starting, I do a detailed consultation to talk through your hair history, goals, and the exact effect you want. I mix a custom colour formula and section your hair to create a blend that suits your hair type, face shape, and lifestyle. After painting, the colour is processed, then toned and finished with a blow-dry so you can see the result right away. Balayage blends your roots with lighter ends, so as your hair grows there's no harsh line. Instead, the colour fades out gently, making grow-out softer and much lower maintenance than traditional highlights. Most people only need touch-ups every 3–6 months, plus a good shampoo and conditioner for coloured hair to keep the colour fresh between appointments.",
  },
  {
    question: "How much does a haircut and blow-dry cost, and what's included?",
    answer: "A women's cut and finish starts at $50. This includes a detailed consultation to discuss your style and hair needs, a professional haircut tailored to suit you, and a blow-dry to finish so you leave with your hair looking polished. You'll also get advice on styling and caring for your hair at home. The service is always personalised, with enough time to make sure you're happy with the end result.",
  },
  {
    question: "Do you offer nanoplasty smoothing?",
    answer: "I don't offer nanoplasty smoothing. Instead, I provide keratin smoothing treatments, which help reduce frizz and make hair smoother and more manageable. The results from a keratin treatment usually last around 4–5 months, depending on your hair type and how you care for your hair after the service.",
  },
  {
    question: "Are you open on Sundays?",
    answer: "Yes. Hair By Melissa is open Sunday 9am to 5pm, Saturday 2pm to 5pm, and Monday to Friday 9am to 1:30pm. Book online or call 0274 799 320.",
  },
  {
    question: "Where can I get a keratin treatment near Helensville?",
    answer: "Hair By Melissa is 15 minutes from Helensville in Kaukapakapa. A keratin treatment is $180 and usually lasts four to five months with good aftercare. Free parking at the door.",
  },
  {
    question: "How do I leave a review for Hair By Melissa?",
    answer: "Go to hairbymelissa.co.nz/review, which opens our Google review form. It takes about a minute, and it helps other locals find a hairdresser they can trust.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title="Hairdresser | Hair Stylist: Kaukapakapa, Helensville, Wainui"
  titleSuffix={false}
  description="Hair stylist and hairdresser for women and kids in Kaukapakapa: balayage, cuts, blow dries, foil highlights and keratin smoothing. Helensville & Wainui."
  keywords="hairdresser kaukapakapa, hair salon kaukapakapa, keratin treatment north auckland, balayage kaukapakapa, highlights helensville, hair colouring wainui, haircut waitoki, best hairdresser rodney district, kids hairdresser kaukapakapa, hair stylist kaukapakapa"
>
  <!-- Core Web Vitals: Preload compressed hero images -->
  <link slot="head" rel="preload" as="image" href="/images/optimized/salon-exterior_640q35.webp" media="(max-width: 767px)" />
  <link slot="head" rel="preload" as="image" href="/images/optimized/salon-exterior_1280q40.webp" media="(min-width: 768px)" />
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center overflow-hidden">
    <!-- Background Layer with Parallax -->
    <div class="absolute inset-0 hero-bg-home parallax-bg" data-speed="0.5"></div>
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/60"></div>
    
    <!-- Animated Blob -->
    <div class="absolute top-20 right-10 w-96 h-96 bg-gradient-to-br from-[#D3E4FD]/20 to-[#FFDEE2]/20 rounded-full morph-blob blur-3xl"></div>
    
    <div class="container-custom relative z-10 mt-20">
      <div class="max-w-2xl animate-fade-in">
        <h1 class="text-5xl md:text-6xl font-bold text-white leading-tight">
          Hairdresser in Kaukapakapa for <span class="gradient-text">Cuts, Colour and Keratin Treatments</span>
        </h1>
        <p class="text-xl text-white mt-6">
          One stylist, unhurried appointments for women and kids, and colour that suits you. 45 minutes from central Auckland, free parking at the door.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/booking/" class="btn-primary magnetic-hover">
            Book online
          </a>
          <a href={business.phoneHref} class="bg-transparent border-2 border-white text-white font-medium py-3 px-6 rounded-md hover:bg-white hover:text-black transition duration-300 ease-in-out glow-hover">
            Call 0274 799 320
          </a>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Services Preview Section -->
  <section class="bg-white section-padding">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl font-bold">Our Premium Services</h2>
        <p class="text-gray-600 mt-4">
          Cuts for women and kids, blow dries, foil highlights, balayage and keratin smoothing. Prices below.
        </p>
      </div>
      
      <!-- Trust Signals -->
      <div class="mb-12">
        <TrustSignals variant="horizontal" />
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.map((service, index) => (
          <div 
            class="glass-card rounded-lg p-8 animate-slide-up card-hover-3d"
            style={`animation-delay: ${index * 100}ms`}
          >
            {service.icon === "sparkles" ? (
              <svg class="h-10 w-10 text-salon-darkblue mb-4 transform transition-transform duration-300 hover:rotate-12" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
                <path d="M5 3v4"></path>
                <path d="M19 17v4"></path>
                <path d="M3 5h4"></path>
                <path d="M17 19h4"></path>
              </svg>
            ) : (
              <svg class="h-10 w-10 text-salon-darkblue mb-4 transform transition-transform duration-300 hover:rotate-12" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="6" cy="18" r="3"></circle>
                <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
                <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
                <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
              </svg>
            )}
            <h3 class="text-xl font-semibold">{service.name}</h3>
            <p class="text-gray-600 mt-2">Starting at {service.price}</p>
            <a
              href={`/services/${service.slug}/`}
              class="inline-flex items-center mt-4 text-salon-darkblue hover-underline"
              aria-label={`Learn more about ${service.name}`}
            >
              {service.name}
              <svg class="h-4 w-4 ml-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </a>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="/services" class="btn-primary">
          View All Services
        </a>
      </div>
    </div>
  </section>
  
  <!-- About Preview Section -->
  <section class="relative section-padding overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-5">
      <div class="absolute inset-0" style="background-image: url('/images/optimized/salon-exterior_1280q40.webp'); background-size: cover; background-position: center; filter: blur(3px);"></div>
    </div>
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-r from-[#D3E4FD]/90 via-white/95 to-[#FFDEE2]/90"></div>
    <div class="container-custom relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="order-2 lg:order-1 animate-fade-in">
          <h2 class="text-4xl font-bold">About Melissa</h2>
          <p class="text-gray-700 mt-4">
            Melissa has built a reputation for creating beautiful, personalized hair transformations in a relaxed, one-stylist salon. Specializing in color techniques and keratin treatments, her passion for helping clients look and feel their best shines through in every appointment.
          </p>
          <p class="text-gray-700 mt-4">
            Using only premium products and staying at the forefront of industry trends, Melissa ensures that each client receives a bespoke service tailored to their unique hair type, face shape, and lifestyle.
          </p>
          <a href="/about" class="btn-primary inline-block mt-6">
            Learn More About Us
          </a>
        </div>
        
        <div class="order-1 lg:order-2">
          <div class="relative">
            <img
              src="/images/optimized/hair-care-general_800.webp"
              alt="Melissa working on client's hair"
              class="rounded-lg shadow-xl w-full h-auto object-cover"
            />
            <div class="absolute -bottom-6 -right-6 bg-white p-4 rounded-lg shadow-lg">
              <div class="flex items-center">
                <svg class="h-8 w-8 text-salon-darkblue mr-3" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="6"></circle>
                  <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path>
                </svg>
                <div>
                  <p class="font-semibold">Qualified</p>
                  <p class="text-sm text-gray-600">Color Specialist</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Local Community Integration Section - Critical for GEO 2024 -->
  <section class="py-16 bg-gradient-to-br from-green-50 to-blue-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl font-bold mb-8">
          <span class="gradient-text">Kaukapakapa's</span> Premier Hair Destination
        </h2>
        <p class="text-xl text-gray-700 mb-12">
          Proudly serving the North Auckland communities of Kaukapakapa, Helensville, Wainui, and Waitoki with expert hair care in our peaceful village setting.
        </p>
        
        <!-- Local Entity Signals for Geographic Relevance -->
        <div class="grid md:grid-cols-4 gap-8 mb-12">
          <div class="text-center" itemscope itemtype="https://schema.org/Place">
            <h3 class="font-bold text-lg mb-2" itemprop="name">Kaukapakapa</h3>
            <p class="text-gray-600" itemprop="description">Main salon location in village center</p>
            <span class="text-sm text-salon-darkblue font-medium">📍 Primary Location</span>
          </div>
          <div class="text-center" itemscope itemtype="https://schema.org/Place">
            <h3 class="font-bold text-lg mb-2" itemprop="name">Helensville</h3>
            <p class="text-gray-600" itemprop="description">15 minutes from our salon</p>
            <span class="text-sm text-salon-darkblue font-medium">🚗 Service Area</span>
          </div>
          <div class="text-center" itemscope itemtype="https://schema.org/Place">
            <h3 class="font-bold text-lg mb-2" itemprop="name">Wainui</h3>
            <p class="text-gray-600" itemprop="description">Local village hair care specialist</p>
            <span class="text-sm text-salon-darkblue font-medium">🏡 Your Local Community</span>
          </div>
          <div class="text-center" itemscope itemtype="https://schema.org/Place">
            <h3 class="font-bold text-lg mb-2" itemprop="name">Waitoki</h3>
            <p class="text-gray-600" itemprop="description">Rural lifestyle hair solutions</p>
            <span class="text-sm text-salon-darkblue font-medium">🐴 Equestrian Area</span>
          </div>
        </div>
        
        <!-- Voice Search FAQ Integration -->
        <div class="bg-white rounded-xl shadow-lg p-8">
          <h3 class="text-2xl font-bold mb-6">Frequently Asked Questions</h3>
          <div class="space-y-4 text-left">
            {homeFaqs.map((faq, i) => (
              <details class="group bg-white rounded-lg shadow p-6" open={i === 0}>
                <summary class="flex items-center justify-between gap-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <h4 class="font-semibold">{faq.question}</h4>
                  <svg class="h-5 w-5 text-salon-darkblue flex-shrink-0 transition-transform duration-200 group-open:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </summary>
                <p class="text-gray-700 mt-4">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      </div>
    </div>
  </section>
  
  <!-- Google Reviews Section -->
  <section class="bg-white section-padding">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl font-bold">What clients say on Google</h2>
        <p class="text-gray-600 mt-4">
          Real reviews from Hair By Melissa clients, straight from our Google profile.
        </p>
      </div>

      <GoogleReviewsWidget />

      <div class="text-center mt-12 flex flex-wrap justify-center gap-4">
        <a href="/review/" target="_blank" rel="noopener" class="btn-primary">
          Leave a Google review
        </a>
        <a href="/gallery/" class="btn-secondary">
          View our work
        </a>
      </div>
    </div>
  </section>
  
  <!-- Gallery Preview -->
  <section class="section-padding bg-[#FFDEE2] bg-opacity-20">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-4xl font-bold">Our Gallery</h2>
        <p class="text-gray-600 mt-4">
          Browse through some of our stunning transformations and get inspired for your next visit.
        </p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {galleryImages.map((image, index) => (
          <div class="relative overflow-hidden rounded-lg group animate-fade-in" style={`animation-delay: ${index * 100}ms`}>
            <OptimizedImage
              src={image.src}
              alt={image.alt}
              width={320}
              height={180}
              loading={index < 2 ? "eager" : "lazy"}
              priority={index < 2}
              sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw"
              class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end justify-center pb-4">
              <span class="text-white font-medium">View Details</span>
            </div>
          </div>
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="/gallery" class="btn-primary">
          View Full Gallery
        </a>
      </div>
    </div>
  </section>
  
  <!-- Booking CTA -->
  <section class="relative section-padding">
    <div class="absolute inset-0 z-0">
      <div class="relative h-full w-full">
        <picture>
          <source 
            media="(max-width: 768px)" 
            srcset="/images/optimized/balayage-transformation_800q25.webp"
          />
          <source 
            media="(max-width: 1280px)" 
            srcset="/images/optimized/balayage-transformation_1280q30.webp"
          />
          <img
            src="/images/optimized/balayage-transformation_1920q35.webp"
            alt="Professional balayage hair transformation showcasing Hair By Melissa's expertise"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </picture>
        <div class="absolute inset-0 bg-black bg-opacity-60"></div>
      </div>
    </div>
    
    <div class="container-custom relative z-10">
      <div class="max-w-3xl mx-auto text-center text-white">
        <h2 class="text-4xl font-bold">Ready for a Transformation?</h2>
        <p class="text-xl mt-4">
          Book your appointment today and experience the Hair By Melissa difference.
        </p>
        <div class="mt-8 flex justify-center">
          <a href="/booking" class="btn-primary inline-flex items-center">
            <svg class="mr-2 h-5 w-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Book Your Appointment
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust Indicators Section -->
  <section class="py-16 bg-white overflow-hidden">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold">Why Choose Hair By Melissa</h2>
        <p class="text-gray-600 mt-4">
          Professional expertise you can trust for all your hair care needs
        </p>
      </div>
      <div class="max-w-4xl mx-auto">
        <TrustSignals variant="grid" showCertification={true} />
      </div>
    </div>
  </section>
  
  <!-- Internal Hub Links Section -->
  <section class="py-20 bg-gradient-to-br from-gray-50 via-white to-[#D3E4FD]/10 overflow-hidden">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-4xl font-bold text-gray-900">Explore Hair By Melissa</h2>
        <p class="text-xl text-gray-600 mt-4">
          Discover our comprehensive range of services, locations we serve, and expert hair care advice to help you achieve your perfect look.
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Keratin Treatments -->
        <div class="group bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 hover:border-salon-darkblue/30">
          <div class="h-48 bg-gradient-to-br from-[#1EAEDB]/20 to-[#0891B2]/10 relative overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <svg class="w-16 h-16 text-salon-darkblue group-hover:scale-110 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path>
              </svg>
            </div>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-2">
              <a href="/services/keratin-treatments" class="text-salon-darkblue hover:text-[#0F7A9C] transition-colors">
                Keratin Treatments
              </a>
            </h3>
            <p class="text-gray-600 mb-4">
              Transform frizzy hair into smooth, manageable locks with our professional $180 keratin treatments. Perfect for North Auckland's coastal climate.
            </p>
            <a href="/services/keratin-treatments" class="inline-flex items-center text-sm font-medium text-salon-darkblue hover:text-[#0F7A9C] transition-colors group">
              Learn About Keratin 
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Balayage Services -->
