---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import { serviceRelationships } from '../../utils/internalLinks.ts';
import { serviceFAQs } from '../../data/serviceFAQs';
import { getService } from '../../data/services';
import business from '../../data/business';

const service = getService('keratin-treatments');

const pageTitle = "Keratin Treatment in North Auckland, $180";
const pageDescription = "Keratin smoothing for frizzy, curly or hard-to-manage hair in Kaukapakapa, North Auckland. $180, about 2 to 3 hours, lasts 4 to 5 months. Book online.";
const pageKeywords = "keratin treatment auckland, keratin treatment north auckland, keratin treatment near me, keratin hair treatment, keratin treatment price nz, keratin treatment salon, keratin treatment helensville, keratin treatment kaukapakapa";

const relatedLinks = serviceRelationships["keratin-treatments"];
const faqs = serviceFAQs['keratin-treatments'];
---

<ServiceLayout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  price={service.price}
  duration={service.duration}
  h1={service.h1}
  serviceName={service.name}
  image="/images/keratin/keratin-hero-1200.webp"
  imageSrcset="/images/keratin/keratin-hero-640.webp 640w, /images/keratin/keratin-hero-1200.webp 1200w, /images/keratin/keratin-hero-1600.webp 1600w"
  imageSizes="100vw"
  imageWidth={1600}
  imageHeight={900}
  imageAlt="Illustration: a hairdresser sealing a keratin treatment into long dark hair with a flat iron"
  ogImage="https://hairbymelissa.co.nz/images/keratin/keratin-hero-og.jpg"
  showCta={false}
>
  <p class="text-lg text-gray-700 mb-6">
    A keratin treatment is a salon smoothing service that calms frizz and makes hair easier to style for around four to five months. At Hair By Melissa in Kaukapakapa, North Auckland, it costs $180 and takes about 2 to 3 hours, one-on-one with Melissa.
  </p>

  <dl class="grid grid-cols-2 sm:grid-cols-4 bg-[#F8F9FA] rounded-lg p-6 mb-6">
    <div>
      <dt class="text-sm uppercase text-gray-600">Price</dt>
      <dd class="font-semibold text-salon-darkblue">$180</dd>
    </div>
    <div>
      <dt class="text-sm uppercase text-gray-600">Time</dt>
      <dd class="font-semibold text-salon-darkblue">About 2 to 3 hours</dd>
    </div>
    <div>
      <dt class="text-sm uppercase text-gray-600">Lasts</dt>
      <dd class="font-semibold text-salon-darkblue">Around 4 to 5 months</dd>
    </div>
    <div>
      <dt class="text-sm uppercase text-gray-600">First wash</dt>
      <dd class="font-semibold text-salon-darkblue">After 72 hours</dd>
    </div>
  </dl>

  <div class="flex flex-wrap gap-4 mb-6">
    <a href="/booking/" class="btn-primary">Book a keratin treatment</a>
    <a href={business.phoneHref} class="btn-secondary">Call {business.phoneDisplay}</a>
  </div>

  <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-12 mb-4">What a keratin treatment does</h2>
  <p class="text-gray-700 mb-4">
    A keratin treatment coats each strand in a smoothing formula, which Melissa seals in with a flat iron. Melissa uses a formaldehyde-free keratin formula. The result is hair that's smoother, shinier and far less frizzy, and that dries faster with less fighting.
  </p>
  <p class="text-gray-700 mb-4">
    It's a good fit if humidity puffs your hair up, if blow-drying takes forever, or if you're tired of straightening every morning. It isn't a permanent straightener. Your hair grows out with its natural texture at the roots, and the smoothing fades gradually rather than leaving a hard line.
  </p>

  <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-12 mb-4">Is keratin right for your hair?</h2>
  <p class="text-gray-700 mb-4">Keratin usually suits:</p>
  <ul class="list-disc pl-6 text-gray-700 space-y-2 mb-4">
    <li>Frizzy or puffy hair, especially in coastal humidity</li>
    <li>Thick or coarse hair that takes a long time to blow-dry</li>
    <li>Wavy or curly hair you'd like smoother and easier to manage</li>
    <li>Coloured hair, with the colour timed around the treatment</li>
  </ul>
  <p class="text-gray-700 mb-4">
    It may not be the right choice if you want to keep your full curl pattern, since keratin relaxes curl and wave. Very fine, flat hair can also lose volume. If you're unsure, Melissa will talk it through with you before anything goes on your hair.
  </p>

  <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-12 mb-4">What happens at your appointment</h2>
  <ol class="list-decimal pl-6 text-gray-700 space-y-3 mb-4">
    <li><strong>Consultation.</strong> Melissa looks at your hair, its history and what you want from it, and tells you honestly whether keratin will get you there.</li>
    <li><strong>Clarifying wash.</strong> Your hair is washed to lift product build-up so the treatment can take evenly.</li>
    <li><strong>Application.</strong> The formula is applied section by section from roots to ends.</li>
    <li><strong>Blow-dry.</strong> Your hair is dried smooth.</li>
    <li><strong>Flat-iron seal.</strong> Melissa works through small sections with a flat iron to seal the treatment in.</li>
    <li><strong>Finish and aftercare.</strong> You leave with smooth, sleek hair and clear instructions for the next 72 hours.</li>
  </ol>

  <figure class="my-8">
    <img
      src="/images/keratin/keratin-process-1200.webp"
      srcset="/images/keratin/keratin-process-640.webp 640w, /images/keratin/keratin-process-1200.webp 1200w"
      sizes="(min-width: 1024px) 590px, 100vw"
      width="1200"
      height="900"
      loading="lazy"
      decoding="async"
      class="w-full h-auto rounded-lg"
      alt="Illustration: keratin formula being brushed onto a section of hair"
    />
    <figcaption class="text-sm text-gray-600 mt-2">Illustration of the application step.</figcaption>
  </figure>

  <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-12 mb-4">How long keratin lasts, and how to make it last</h2>
  <p class="text-gray-700 mb-4">
    A keratin treatment lasts around four to five months. How long yours lasts depends on your hair and how you look after it.
  </p>
  <p class="text-gray-700 mb-4">
    For the first 72 hours, keep your hair dry and loose: no washing, no ponytails, clips or tucking it behind your ears. After that, wash with a sulfate-free shampoo in lukewarm water, and no more than two or three times a week. Wait at least two weeks before any colour.
  </p>
  <p class="text-gray-700 mb-4">
    <span class="font-semibold">Want the day-by-day version? Read our <a href="/blog/keratin-aftercare/" class="text-salon-darkblue underline hover:text-[#0F7A9C]">keratin aftercare guide: when you can wash, brush and tie up your hair</a>.</span>
  </p>

  <figure class="my-8">
    <img
      src="/images/keratin/keratin-aftercare-1200.webp"
      srcset="/images/keratin/keratin-aftercare-640.webp 640w, /images/keratin/keratin-aftercare-1200.webp 1200w"
      sizes="(min-width: 1024px) 590px, 100vw"
      width="1200"
      height="900"
      loading="lazy"
      decoding="async"
      class="w-full h-auto rounded-lg"
      alt="Illustration: sulfate-free shampoo, a wide-tooth comb and a silk pillowcase for keratin aftercare"
    />
    <figcaption class="text-sm text-gray-600 mt-2">Illustration: a simple, gentle aftercare routine.</figcaption>
  </figure>

  <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-12 mb-4">Keratin treatment price in North Auckland</h2>
  <p class="text-gray-700 mb-4">
    A keratin treatment at Hair By Melissa is <strong>$180</strong>, and the appointment takes about 2 to 3 hours. It's one-on-one with Melissa, with free parking at the door.
  </p>
  <p class="text-gray-700 mb-4">
    Want a trim as well? Add a <a href="/services/womens-cut-finish/" class="text-salon-darkblue underline hover:text-[#0F7A9C]">women's cut and finish</a> ($50) when you book.
  </p>

  <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-12 mb-4">Keratin or nanoplasty?</h2>
  <p class="text-gray-700 mb-4">
    Nanoplasty is a different smoothing treatment that uses a different formula. Hair By Melissa doesn't offer nanoplasty. If you've been searching for it because you want smoother, frizz-free hair that's quicker to style, a keratin treatment is built for the same goal, and Melissa is happy to talk through whether it suits your hair before you book.
  </p>

  <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-12 mb-4">Coming from Helensville, Kumeū or nearby?</h2>
  <p class="text-gray-700 mb-4">
    The salon is at 12 Magnolia Lane in Kaukapakapa, about 15 minutes from <a href="/locations/helensville/" class="text-salon-darkblue underline hover:text-[#0F7A9C]">Helensville</a> and about 25 minutes from <a href="/locations/kumeu/" class="text-salon-darkblue underline hover:text-[#0F7A9C]">Kumeū</a>, with clients also coming from <a href="/locations/wainui/" class="text-salon-darkblue underline hover:text-[#0F7A9C]">Wainui</a> and <a href="/locations/waitoki/" class="text-salon-darkblue underline hover:text-[#0F7A9C]">Waitoki</a>. It's open seven days, including Sundays.
  </p>
  <p class="text-gray-700 mb-4"><strong>Hours:</strong> {business.hoursLine}</p>

  <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mt-12 mb-4">Keratin treatment FAQs</h2>
  <div class="mb-4">
    {faqs.map((faq) => (
      <details class="group bg-white rounded-lg border border-gray-200 mb-3">
        <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <h3 class="font-semibold text-lg text-gray-900">{faq.question}</h3>
          <svg
            class="h-5 w-5 text-gray-500 flex-shrink-0 group-open:rotate-45 transition-transform"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 5v14"></path>
            <path d="M5 12h14"></path>
          </svg>
        </summary>
        <p class="px-5 pb-5 text-gray-700">{faq.answer}</p>
      </details>
    ))}
  </div>

  <FAQSchema faqs={faqs} pageUrl="https://hairbymelissa.co.nz/services/keratin-treatments/" schemaOnly />

  <div class="bg-[#D3E4FD] bg-opacity-20 rounded-lg p-8 mt-12">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">Book your keratin treatment in Kaukapakapa</h2>
    <p class="text-gray-700 mb-4">$180, about 2 to 3 hours, one-on-one with Melissa. Book online any time or call {business.phoneDisplay}.</p>
    <div class="flex flex-wrap gap-4">
      <a href="/booking/" class="btn-primary">Book online</a>
      <a href={business.phoneHref} class="btn-secondary">Call {business.phoneDisplay}</a>
    </div>
  </div>

  <RelatedLinks links={relatedLinks} slot="after" />
</ServiceLayout>
