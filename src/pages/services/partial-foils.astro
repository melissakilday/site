---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import { serviceFAQs } from '../../data/serviceFAQs';
import { getService } from '../../data/services';

const service = getService('partial-foils');

const pageTitle = "Partial Foils $150, Kaukapakapa";
const pageDescription = "Partial foils in Kaukapakapa, North Auckland. $150, about 1-1.5 hours with Melissa. Face-framing dimension, free parking, online booking, open 7 days.";

const faqs = serviceFAQs['partial-foils'];
---

<ServiceLayout
  title={pageTitle}
  description={pageDescription}
  price={service.price}
  duration={service.duration}
  h1={service.h1}
  serviceName={service.name}
  image="/images/blog/half-head-vs-full-head-foils-1200.webp"
  imageSrcset="/images/blog/half-head-vs-full-head-foils-640.webp 640w, /images/blog/half-head-vs-full-head-foils-1200.webp 1200w, /images/blog/half-head-vs-full-head-foils-1600.webp 1600w"
  imageSizes="100vw"
  imageWidth={1600}
  imageHeight={893}
  imageAlt="Illustration: a hairdresser placing foils through a client's hair"
  ogImage="https://hairbymelissa.co.nz/images/blog/half-head-vs-full-head-foils-og.jpg"
>
  <h2 class="text-3xl font-bold mb-6">What are partial foils?</h2>

  <p class="text-gray-700 mb-6">
    Partial foils are highlights placed around your face and crown, which is about 20 to 30% of your hair. They're the lightest foil option, and a good way to brighten up or blend grey around your hairline. At Hair By Melissa they're $150 and take 1 to 1.5 hours. Wondering how much of your head you need done? Read <a href="/blog/half-head-vs-full-head-foils/" class="text-salon-darkblue underline hover:text-[#0F7A9C]">half head vs full head foils</a>.
  </p>

  <h2 class="text-3xl font-bold mb-6">Add Dimension with Strategic Highlights</h2>
  
  <p class="text-gray-700 mb-6">
    Partial foils are the perfect solution for adding subtle dimension and brightness to your hair without the commitment of <a href="/services/half-head-highlights/" class="text-salon-darkblue font-semibold hover:underline">half head highlights</a> or a full head of highlights. This technique focuses on strategic placement around your face and crown, creating a natural, sun-kissed effect that enhances your features and adds movement to your style.
  </p>

  <h2 class="text-2xl font-semibold mb-4">What Are Partial Foils?</h2>
  <p class="text-gray-700 mb-6">
    Partial foiling is a highlighting technique where selected sections of hair are wrapped in foils with lightener or colour. Typically covering 20-30% of your head, this service concentrates on the areas that frame your face, the crown, and the top layers of your hair – the sections most visible and impactful for creating dimension.
  </p>

  <h2 class="text-2xl font-semibold mb-4">Benefits of Partial Foils</h2>
  <ul class="list-disc list-inside text-gray-700 mb-6 space-y-2">
    <li>Creates natural-looking dimension and depth</li>
    <li>Brightens your complexion and enhances facial features</li>
    <li>Lower maintenance than full highlights</li>
    <li>More affordable option for regular colour maintenance</li>
    <li>Perfect for first-time highlight clients</li>
    <li>Adds movement and texture to single-tone hair</li>
    <li>Can be customised for subtle or bold effects</li>
  </ul>

  <h2 class="text-2xl font-semibold mb-4">Ideal Candidates</h2>
  <p class="text-gray-700 mb-6">
    Partial foils are perfect for:
  </p>
  <ul class="list-disc list-inside text-gray-700 mb-6 space-y-2">
    <li>Those wanting to brighten their look without dramatic change</li>
    <li>Natural brunettes seeking sun-kissed dimension</li>
    <li>Clients looking to blend away grey hair around the face</li>
    <li>Anyone wanting to test highlights before committing to full coverage</li>
    <li>Busy professionals needing low-maintenance colour</li>
  </ul>

  <h2 class="text-2xl font-semibold mb-4">The Application Process</h2>
  <ol class="list-decimal list-inside text-gray-700 mb-6 space-y-2">
    <li>Consultation to determine desired lightness and placement</li>
    <li>Section hair strategically for optimal highlight placement</li>
    <li>Apply lightener or colour to selected sections</li>
    <li>Wrap each section in foil for controlled processing</li>
    <li>Monitor development for perfect lift</li>
    <li>Rinse and apply toner if needed for desired tone</li>
    <li>Deep condition to maintain hair health</li>
    <li>Style to showcase your new dimension</li>
  </ol>

  <h2 class="text-2xl font-semibold mb-4">Maintenance Guide</h2>
  <div class="bg-[#FFDEE2] bg-opacity-20 rounded-lg p-6 mb-6">
    <h3 class="font-semibold mb-3">Keep Your Highlights Fresh:</h3>
    <ul class="list-disc list-inside text-gray-700 space-y-2">
      <li>Touch up every 4-6 weeks to maintain brightness</li>
      <li>Use colour-safe shampoo and conditioner</li>
      <li>Apply purple shampoo weekly to prevent brassiness</li>
      <li>Deep condition weekly to maintain shine</li>
      <li>Protect hair from sun exposure with UV spray</li>
      <li>Use heat protectant before styling</li>
    </ul>
  </div>

  <h2 class="text-2xl font-semibold mb-4">Colour Customisation</h2>
  <p class="text-gray-700 mb-6">
    Melissa specialises in creating custom colour that complements your skin tone and natural hair colour. Whether you prefer:
  </p>
  <ul class="list-disc list-inside text-gray-700 mb-6 space-y-2">
    <li>Subtle, natural highlights just 1-2 shades lighter</li>
    <li>Medium contrast for noticeable but not dramatic change</li>
    <li>Bold, high-contrast highlights for maximum impact</li>
    <li>Warm tones (golden, honey, caramel)</li>
    <li>Cool tones (ash, pearl, icy)</li>
  </ul>

  <div class="bg-[#D3E4FD] bg-opacity-20 rounded-lg p-6">
    <p class="text-gray-700 italic">
      "Partial foils are like jewelry for your hair – they catch the light and add sparkle exactly where you need it most. It's amazing how strategic highlights can transform your entire look."
    </p>
  </div>
  <!-- FAQ Schema -->
  <Fragment slot="after">
    <FAQSchema 
      faqs={faqs} 
      pageUrl="https://hairbymelissa.co.nz/services/partial-foils/"
    />
  </Fragment>
</ServiceLayout>