---
import Layout from '../../layouts/Layout.astro';
import BlogArticleSchema from '../../components/BlogArticleSchema.astro';

const pageTitle = "Hair Colour Maintenance: Keep It Vibrant";
const pageDescription = "Essential tips for maintaining vibrant hair colour in North Auckland's variable climate, from a Kaukapakapa hairdresser.";
const pageKeywords = "hair colour maintenance kaukapakapa, colour protection north auckland, vibrant hair colour tips, colour care rural auckland, balayage maintenance";

const publishDate = "2025-01-22";
const readTime = "8 min read";
const category = "Colour Insights";
const author = "Melissa - Hair By Melissa";
const slug = "hair-color-maintenance";
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  pageType="article"
