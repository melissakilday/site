---
import Layout from '../../layouts/Layout.astro';
import BlogArticleSchema from '../../components/BlogArticleSchema.astro';
import FAQSchema from '../../components/FAQSchema.astro';

const pageTitle = "Keratin Aftercare: When Can You Wash Your Hair?";
const pageDescription = "Wait 72 hours before washing. What to avoid, when you can brush, tie or dry-shampoo, and how to make a keratin treatment last 5 months. By an NZ stylist.";
const pageKeywords = "keratin aftercare, keratin treatment maintenance, post keratin care, keratin treatment tips, smooth hair maintenance, frizz-free hair care, keratin products";
const slug = "keratin-aftercare";
const publishDate = "2025-01-20";
const readTime = "6 min read";
const category = "Hair Care Tips";
const author = "Melissa";
const featuredImage = "https://hairbymelissa.co.nz/images/optimized/keratin-before-after_1200.webp";

// Single FAQ source of truth — drives both the visible accordion and the
// FAQPage JSON-LD via FAQSchema.astro. Questions are character-identical to
// the 8 H2s below.
const faqs = [
  {
    question: "When can I wash my hair after a keratin treatment?",
    answer: "Wait 72 hours before washing your hair after a keratin treatment; 48 hours is the absolute minimum for most formulas. The keratin is still bonding with your hair cuticles during that window, so moisture can disrupt the process."
  },
  {
    question: "Can I brush or comb my hair after keratin?",
    answer: "In the first 72 hours, avoid brushing — only gently comb with a wide-tooth comb if absolutely necessary. After that, gently brush morning and night to distribute natural oils and keep hair smooth."
  },
  {
    question: "Can I tie my hair up after keratin?",
    answer: "No — for the first 72 hours keep your hair completely loose. No ponytails, clips, bands, headbands, hats or tucking behind your ears, since any crease can set into the new keratin bonds."
  },
  {
    question: "Can I use dry shampoo after a keratin treatment?",
    answer: "Yes — dry shampoo is the one product allowed during the first 72 hours if your roots get oily, applied sparingly at the roots only. Afterwards, it's a good way to stretch out your 2–3 washes a week."
  },
  {
    question: "What happens if my hair gets wet in the first 72 hours?",
    answer: "Don't panic — immediately blow-dry your hair straight with medium heat and a round brush to reset it. It isn't ideal and may shorten how long the treatment lasts, but quick action limits the damage."
  },
  {
    question: "What shampoo should I use after keratin?",
    answer: "Use a sulfate-free, sodium-chloride-free, pH-balanced shampoo and conditioner — sulfates strip keratin from the hair and shorten the treatment's life. Wash no more than 2–3 times a week with lukewarm water and a cool final rinse."
  },
  {
    question: "How long does a keratin treatment last?",
    answer: "A keratin treatment lasts three to five months with proper aftercare, and up to 5 months with Hair By Melissa's formaldehyde-free formula. Sulfate-free products and limited heat styling extend its life — book a touch-up once frizz returns to the roots or it's been 4–5 months."
  },
  {
    question: "When can I colour my hair after keratin?",
    answer: "Wait at least 2 weeks after a keratin treatment before any chemical colour processing. Book a consultation so your stylist can plan your colour and keratin schedule together."
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  pageType="article"
>
  <!-- Article Header -->
  <article class="pt-32 pb-16">
    <header class="container-custom mb-12">
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm">
          <li><a href="/" class="text-gray-600 hover:text-salon-darkblue">Home</a></li>
          <li class="text-gray-400">/</li>
          <li><a href="/blog" class="text-gray-600 hover:text-salon-darkblue">Blog</a></li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-900 font-medium">Keratin Aftercare Guide</li>
        </ol>
      </nav>

      <div class="max-w-4xl">
        <div class="flex items-center space-x-4 mb-4">
          <span class="bg-[#D3E4FD] text-salon-darkblue px-3 py-1 rounded-full text-sm font-medium">
            Hair Care Tips
          </span>
          <div class="flex items-center text-gray-500 text-sm space-x-4">
            <span class="flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              6 min read
            </span>
            <span class="flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              20 Jan 2025
            </span>
            <span class="flex items-center">
              <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
              By Melissa
            </span>
          </div>
        </div>

        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
          Keratin treatment aftercare: when to wash, brush and style your hair
        </h1>

        <!-- Quick-answer box: first content block after the H1 -->
        <div class="bg-[#D3E4FD] bg-opacity-40 border-l-4 border-salon-darkblue p-6 rounded-lg mb-6">
          <p class="text-gray-800 mb-0">
            <strong>Quick answer:</strong> Wait <strong>72 hours</strong> before your first wash (48 hours is the absolute minimum for most formulas). Until then keep hair dry, straight and loose: no hair ties, clips, tucking behind ears, or sweat. After that, use a sulfate-free shampoo and wash no more than 2–3 times a week.
          </p>
        </div>

        <!-- Early soft CTA -->
        <div class="bg-gray-50 border border-gray-200 p-5 rounded-lg text-gray-700">
          <p class="mb-0">
            Based in North Auckland? Melissa does keratin treatments at her Kaukapakapa salon for $180, about 2–3 hours. <a href="/services/keratin-treatments/" class="text-salon-darkblue font-semibold hover:underline">See the keratin treatment →</a>
          </p>
        </div>
      </div>
    </header>

    <!-- Article Content -->
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="prose prose-lg max-w-none">

          <!-- Intro (demoted from old "Why Aftercare Matters" H2 — no heading, not one of the 8 questions) -->
          <p class="text-gray-700">
            A keratin treatment is an investment in your hair's health and manageability. At Hair By Melissa, our formaldehyde-free keratin treatments can last up to 5 months — but only with proper aftercare. Here's exactly what to do, question by question.
          </p>

          <!-- Q1 -->
          <section class="mb-12">
            <h2 class="text-3xl font-bold mb-6">When can I wash my hair after a keratin treatment?</h2>

            <p class="text-gray-700 mb-6">
              Wait 72 hours before washing your hair after a keratin treatment — 48 hours is the absolute minimum for most formulas. During this window the keratin is still bonding with your hair cuticles, and moisture, chemicals or physical manipulation can disrupt that process and reduce how long the treatment lasts.
            </p>

            <h3 class="text-xl font-semibold mb-4">Also avoid for 72 hours</h3>
            <div class="bg-red-50 p-6 rounded-lg border border-red-200">
              <ul class="text-red-700 space-y-1">
                <li>• No swimming, rain or humidity</li>
                <li>• No heat styling tools, saunas or steam rooms</li>
                <li>• No hair products except a recommended dry shampoo</li>
                <li>• Avoid excessive sweating</li>
              </ul>
            </div>
          </section>

          <!-- Q2 -->
          <section class="mb-12">
            <h2 class="text-3xl font-bold mb-6">Can I brush or comb my hair after keratin?</h2>

            <p class="text-gray-700 mb-6">
              Not in the first 72 hours — avoid brushing altogether, and only comb gently with a wide-tooth comb if it's absolutely necessary. Don't touch or run your fingers through your hair, and try to keep head movement to a minimum while you sleep.
            </p>

            <div class="bg-red-50 p-6 rounded-lg border border-red-200 mb-8">
              <h4 class="font-semibold text-red-800 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                NO Physical Manipulation (first 72 hours)
              </h4>
              <ul class="text-red-700 space-y-1">
                <li>• Don't touch or run fingers through hair</li>
                <li>• Avoid tucking behind ears</li>
                <li>• No excessive head movement during sleep</li>
              </ul>
            </div>

            <h3 class="text-xl font-semibold mb-4">Brushing once you're past 72 hours</h3>
            <div class="bg-white border border-gray-200 p-4 rounded-lg">
              <ul class="text-gray-700 space-y-1">
                <li>• Morning: gently brush with a wide-tooth comb, apply leave-in conditioner to the ends, and use heat protectant before styling</li>
                <li>• Night: brush gently to distribute natural oils, sleep on a silk or satin pillowcase, and avoid tight hairstyles</li>
              </ul>
            </div>
          </section>

          <!-- Q3 -->
          <section class="mb-12">
            <h2 class="text-3xl font-bold mb-6">Can I tie my hair up after keratin?</h2>

            <p class="text-gray-700 mb-6">
              No — for the first 72 hours your hair needs to stay completely loose. Any tie, clip or crease can set into the new keratin bonds while they're still forming, leaving a dent or wave where it shouldn't be.
            </p>

            <div class="bg-red-50 p-6 rounded-lg border border-red-200">
              <h4 class="font-semibold text-red-800 mb-3 flex items-center">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
                NO Hair Accessories (first 72 hours)
              </h4>
              <ul class="text-red-700 space-y-1">
                <li>• No ponytails or buns</li>
                <li>• Avoid hair clips or bands</li>
                <li>• No headbands or hats</li>
                <li>• Sleep with hair completely loose</li>
              </ul>
            </div>
          </section>

          <!-- Q4 -->
          <section class="mb-12">
            <h2 class="text-3xl font-bold mb-6">Can I use dry shampoo after a keratin treatment?</h2>

            <p class="text-gray-700 mb-0">
              Yes — dry shampoo is the one product you're allowed to use during the first 72 hours if your roots get oily, applied sparingly at the roots only. Once you're past the 72-hour mark, dry shampoo between washes is a good way to stretch out your 2–3 washes a week and keep the treatment lasting longer.
            </p>
          </section>

          <!-- Mid-article CTA — immediately after Q4 -->
          <div class="bg-gradient-to-r from-[#1EAEDB] to-[#0891B2] text-white p-6 rounded-lg mb-12 text-center">
            <p class="text-lg mb-0">
              Ready for smooth hair that lasts? <a href="/services/keratin-treatments/" class="underline font-semibold">Book a keratin treatment in North Auckland</a> or call <a href="tel:+64274799320" class="underline font-semibold">0274 799 320</a>.
            </p>
          </div>

          <!-- Q5 -->
          <section class="mb-12">
            <h2 class="text-3xl font-bold mb-6">What happens if my hair gets wet in the first 72 hours?</h2>

            <p class="text-gray-700 mb-6">
              Don't panic — immediately blow-dry your hair straight with medium heat and a round brush to reset it. It isn't ideal and can shorten how long the treatment lasts, but quick action minimizes the damage. Contact your stylist if you're concerned about the result.
            </p>

            <h3 class="text-2xl font-semibold mb-4">Troubleshooting common issues</h3>
            <div class="space-y-6">
              <div class="bg-white border border-gray-200 p-6 rounded-lg">
                <h4 class="text-xl font-semibold mb-3 text-red-600">Problem: Hair Feels Stiff or Crunchy</h4>
                <p class="text-gray-700 mb-3"><strong>Cause:</strong> Product buildup or using the wrong products</p>
                <ul class="text-gray-700 space-y-1 ml-4">
                  <li>• Use a clarifying shampoo once, then a deep conditioning treatment</li>
                  <li>• Switch to keratin-safe products</li>
                </ul>
              </div>

              <div class="bg-white border border-gray-200 p-6 rounded-lg">
                <h4 class="text-xl font-semibold mb-3 text-red-600">Problem: Frizz Returning Early</h4>
                <p class="text-gray-700 mb-3"><strong>Cause:</strong> Using sulfate shampoos or exposure to chlorine</p>
                <ul class="text-gray-700 space-y-1 ml-4">
                  <li>• Switch to sulfate-free products and increase deep conditioning</li>
                  <li>• Reduce heat styling frequency, or consider a touch-up treatment</li>
                </ul>
              </div>

              <div class="bg-white border border-gray-200 p-6 rounded-lg">
                <h4 class="text-xl font-semibold mb-3 text-red-600">Problem: Hair Looks Greasy or Flat</h4>
                <p class="text-gray-700 mb-3"><strong>Cause:</strong> Over-conditioning or using too much product</p>
                <ul class="text-gray-700 space-y-1 ml-4">
                  <li>• Reduce conditioning frequency and focus it on the ends only</li>
                  <li>• Use less product, or try a lightweight leave-in conditioner</li>
                </ul>
              </div>
            </div>
          </section>

          <!-- Q6 -->
          <section class="mb-12">
            <h2 class="text-3xl font-bold mb-6">What shampoo should I use after keratin?</h2>

            <p class="text-gray-700 mb-6">
              Use a sulfate-free, sodium chloride-free, pH-balanced shampoo and conditioner — sulfates strip the keratin from your hair and shorten the treatment's lifespan. Wash no more than 2–3 times a week with lukewarm water and finish with a cool rinse to seal the cuticle.
            </p>

            <h3 class="text-2xl font-semibold mb-4">Product recommendations</h3>
            <div class="bg-blue-50 p-8 rounded-lg mb-8">
              <h4 class="text-xl font-semibold mb-4 text-blue-800">Essential Product Guidelines</h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div>
                  <h5 class="font-semibold mb-3 text-green-700 flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    MUST USE
                  </h5>
                  <ul class="space-y-2 text-gray-700">
                    <li><strong>Sulfate-Free Shampoo:</strong> Protects keratin bonds</li>
                    <li><strong>Sodium Chloride-Free Products:</strong> Prevents treatment breakdown</li>
                    <li><strong>pH-Balanced Conditioner:</strong> Maintains hair health</li>
                    <li><strong>Heat Protectant:</strong> Essential before any heat styling</li>
                    <li><strong>Deep Conditioning Mask:</strong> Weekly treatments</li>
                  </ul>
                </div>
                <div>
                  <h5 class="font-semibold mb-3 text-red-700 flex items-center">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                    AVOID COMPLETELY
                  </h5>
                  <ul class="space-y-2 text-gray-700">
                    <li><strong>Sulfate-Based Shampoos:</strong> Strip keratin treatment</li>
                    <li><strong>Clarifying Shampoos:</strong> Too harsh for treated hair</li>
                    <li><strong>Sea Salt Sprays:</strong> Dry out treated hair</li>
                    <li><strong>Alcohol-Based Products:</strong> Cause dryness and frizz</li>
                    <li><strong>Products with Parabens:</strong> Can break down treatment</li>
                  </ul>
                </div>
              </div>
            </div>

            <h3 class="text-2xl font-semibold mb-4">Optimal washing routine</h3>
            <div class="bg-white border border-gray-200 p-6 rounded-lg mb-6">
              <h4 class="font-semibold mb-3">Step-by-Step Washing Process</h4>
              <ol class="space-y-3 text-gray-700">
                <li class="flex items-start">
                  <span class="bg-salon-darkblue text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-1">1</span>
                  <div>
                    <strong>Pre-rinse:</strong> lukewarm water only — hot water opens the cuticle and can strip the keratin.
                  </div>
                </li>
                <li class="flex items-start">
                  <span class="bg-salon-darkblue text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-1">2</span>
                  <div>
                    <strong>Shampoo gently:</strong> sulfate-free, focused on the scalp, no scrubbing.
                  </div>
                </li>
                <li class="flex items-start">
                  <span class="bg-salon-darkblue text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-1">3</span>
                  <div>
                    <strong>Condition:</strong> mid-length to ends only, leave 2-3 minutes, then rinse.
                  </div>
                </li>
                <li class="flex items-start">
                  <span class="bg-salon-darkblue text-white rounded-full w-6 h-6 flex items-center justify-center text-sm font-bold mr-3 mt-1">4</span>
                  <div>
                    <strong>Cool rinse:</strong> seals the cuticle and locks in the treatment.
                  </div>
                </li>
              </ol>
            </div>

            <div class="bg-gray-50 p-6 rounded-lg">
              <h4 class="font-semibold mb-3">Washing Frequency Guidelines</h4>
              <ul class="space-y-2 text-gray-700">
                <li><strong>Week 1-2:</strong> Wash 2-3 times maximum</li>
                <li><strong>Week 3-8:</strong> Wash every 2-3 days as needed</li>
                <li><strong>Month 2+:</strong> Return to normal washing schedule (every other day or daily if needed)</li>
                <li><strong>Pro Tip:</strong> Use dry shampoo between washes to extend time between washing</li>
              </ul>
            </div>
          </section>

          <!-- Q7 -->
          <section class="mb-12">
            <h2 class="text-3xl font-bold mb-6">How long does a keratin treatment last?</h2>

            <p class="text-gray-700 mb-6">
              A keratin treatment lasts three to five months with proper aftercare — Hair By Melissa's formaldehyde-free formula can last up to 5 months when you follow the wash, product and heat-styling guidelines above. Limiting heat, using the right products and handling hair gently all extend its life.
            </p>

            <h3 class="text-xl font-semibold mb-4">Heat styling best practices</h3>
            <div class="bg-white border border-gray-200 p-4 rounded-lg mb-8">
              <ul class="text-gray-700 space-y-1">
                <li>• Flat iron 300-350°F max, curling iron 300°F max, always with heat protectant</li>
                <li>• Heat styling maximum 2-3 times per week — air dry the rest of the time</li>
                <li>• Blow dryer on medium heat with a cool shot finish</li>
              </ul>
            </div>

            <h3 class="text-xl font-semibold mb-4">When to book your next treatment</h3>
            <div class="bg-gradient-to-r from-[#D3E4FD] to-[#FFDEE2] p-8 rounded-lg">
              <h4 class="font-semibold mb-4">Signs It's Time for a Touch-Up</h4>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-yellow-500 mr-2 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                  </svg>
                  <span>Frizz returning to the root area, or hair texture feeling coarser</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-yellow-500 mr-2 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                  </svg>
                  <span>Increased styling time needed, or humidity affecting hair more</span>
                </li>
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-yellow-500 mr-2 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.732 16.5c-.77.833.192 2.5 1.732 2.5z"></path>
                  </svg>
                  <span>4-5 months since your last treatment</span>
                </li>
              </ul>
            </div>
          </section>

          <!-- Q8 -->
          <section class="mb-12">
            <h2 class="text-3xl font-bold mb-6">When can I colour my hair after keratin?</h2>

            <p class="text-gray-700 mb-0">
              Wait at least 2 weeks after a keratin treatment before any chemical colour processing. Timing matters — book a consultation so your stylist can plan your colour and keratin schedule together for the best results without compromising either treatment.
            </p>
          </section>

          <!-- FAQ Section: single source of truth drives both visible accordion and JSON-LD -->
          <FAQSchema faqs={faqs} pageUrl="https://hairbymelissa.co.nz/blog/keratin-aftercare/" />

          <!-- Call to Action -->
          <section class="bg-gradient-to-r from-[#1EAEDB] to-[#0891B2] p-8 rounded-lg text-white text-center mt-12">
            <h3 class="text-2xl font-bold mb-4">Ready for Your Keratin Treatment?</h3>
            <p class="text-lg mb-6">
              Experience the transformative power of our professional keratin treatments at Hair By Melissa. Located in Kaukapakapa, serving all of North Auckland with premium hair care.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="/services/keratin-treatments" class="bg-white text-salon-darkblue font-semibold py-3 px-6 rounded-md hover:bg-gray-100 transition">
                Learn About Our Keratin Service
              </a>
              <a href="/booking" class="bg-transparent border-2 border-white text-white font-semibold py-3 px-6 rounded-md hover:bg-white hover:text-salon-darkblue transition">
                Book Your Appointment
              </a>
            </div>
          </section>

        </div>
      </div>
    </div>
  </article>

  <!-- Related Services & Information -->
  <section class="py-16 bg-white">
    <div class="container-custom">
      <h2 class="text-3xl font-bold text-center mb-12">Enhance Your Keratin Results</h2>
      <div class="grid md:grid-cols-3 gap-8 mb-16">
        <div class="bg-white rounded-lg shadow-md p-6 border border-gray-100 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-salon-darkblue rounded-lg flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4a2 2 0 104 0m-4 0a2 2 0 100-4m0 4a2 2 0 100 4m0-4a2 2 0 104 0m-4 0a2 2 0 104 0"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-3">
            <a href="/services/keratin-treatments" class="text-salon-darkblue hover:text-[#0F7A9C] transition-colors">
              Keratin Treatment Service
            </a>
          </h3>
          <p class="text-gray-600 mb-4">
            Professional keratin treatments in Kaukapakapa. Transform frizzy hair into smooth, manageable locks for up to 5 months.
          </p>
          <a href="/services/keratin-treatments" class="text-sm font-medium text-salon-darkblue hover:text-[#0F7A9C] transition-colors inline-flex items-center">
            Book Keratin Treatment
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>

