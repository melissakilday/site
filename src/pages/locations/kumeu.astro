---
import Layout from '../../layouts/Layout.astro';
import FAQSchema from '../../components/FAQSchema.astro';
import { locationFAQs } from '../../data/locationFAQs';
import { business } from '../../data/business';
import { getService } from '../../data/services';

const pageTitle = "Kumeū Hairdresser, 25 Min Up SH16, Free Parking";
const pageDescription = "Kumeū hairdresser? Hair By Melissa is 25 minutes up SH16 in Kaukapakapa — balayage, keratin and colour by appointment. Free parking. Book online.";
const pageKeywords = "hairdresser kumeu, hair salon kumeu, hairdresser huapai, hair salon huapai, balayage kumeu, keratin treatment kumeu, hair salon near kumeu";

const faqs = locationFAQs['kumeu'];

// Services popular with Kumeū clients — price/duration sourced from data/services.ts
const kumeuServices = [
  {
    service: getService('balayage'),
    description: "Low-maintenance, hand-painted colour that grows out softly between visits",
  },
  {
    service: getService('keratin-treatments'),
    description: "A regular pick for taming frizz and humidity on the drive back down SH16",
  },
  {
    service: getService('half-head-highlights'),
    description: "Brightness and dimension without a full head of colour",
  },
  {
    service: getService('womens-cut-finish'),
    description: "A precise cut and blow-dry finish for everyday and special occasions",
  },
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  pageType="website"
>
  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#D3E4FD] via-white to-[#FFDEE2] opacity-90"></div>
    <div class="absolute top-20 right-10 w-96 h-96 bg-gradient-to-br from-[#1EAEDB]/10 to-[#FFDEE2]/20 rounded-full morph-blob blur-3xl"></div>

    <div class="container-custom relative z-10">
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm">
          <li><a href="/" class="text-gray-600 hover:text-salon-darkblue">Home</a></li>
          <li class="text-gray-400">/</li>
          <li><a href="/locations" class="text-gray-600 hover:text-salon-darkblue">Locations</a></li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-900 font-medium">Kumeū</li>
        </ol>
      </nav>

      <div class="max-w-4xl">
        <h1 class="text-5xl md:text-6xl font-bold leading-tight mb-6">
          Your hairdresser about 25 minutes from Kumeū
        </h1>
        <p class="text-xl text-gray-700 mb-8">
          Hair By Melissa is a home salon in Kaukapakapa, roughly 25 minutes up SH16 from Kumeū and Huapai. Balayage, <a href="/services/keratin-treatments/" class="text-salon-darkblue underline hover:text-[#0F7A9C]">keratin</a>, colour and cuts with one stylist, no double-booking, and free parking at the door.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/booking/" class="btn-primary inline-flex items-center justify-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            Book online
          </a>
          <a href={business.phoneHref} class="bg-transparent border-2 border-gray-900 text-gray-900 font-medium py-3 px-6 rounded-md hover:bg-gray-900 hover:text-white transition duration-300 ease-in-out inline-flex items-center justify-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            Call {business.phoneDisplay}
          </a>
        </div>
        <p class="text-sm text-gray-600 mt-4">
          Open 7 days · {business.hoursLine}
        </p>
      </div>
    </div>
  </section>

  <!-- Why Kumeū clients make the drive -->
  <section class="py-16 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold mb-8">Why Kumeū and Huapai clients make the drive</h2>

        <div class="prose prose-lg max-w-none text-gray-700">
          <p class="text-xl mb-6">
            We don't have a salon in Kumeū — we're a home salon on Magnolia Lane in Kaukapakapa, about 25 minutes further up SH16 through Waimauku. It's an approximate drive time; give yourself a little extra if you're travelling at peak times.
          </p>

          <p class="mb-6">
            What brings Kumeū clients past the closer options is the appointment itself. It's a quiet, one-on-one salon — one stylist, one client at a time, no double-booking and no waiting around. You get free parking right at the door, and a booking that starts and finishes when it's supposed to.
          </p>

          <p class="mb-6">
            For a lot of clients, the drive becomes part of the appointment rather than a downside — a straightforward run through Waimauku's countryside instead of a wait in a busy Kumeū car park.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Kumeū clients book -->
  <section id="services" class="py-16 bg-gray-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold mb-8 text-center">Services Kumeū clients tend to book</h2>
        <p class="text-xl text-gray-600 text-center mb-12">
          The full service list is available at every appointment — these are the ones Kumeū and Huapai clients ask for most.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {kumeuServices.map((item) => (
            <div class="bg-white rounded-lg shadow-lg p-8">
              <h3 class="text-2xl font-bold mb-3">{item.service.name}</h3>
              <div class="flex justify-between items-center mb-4">
                <span class="text-3xl font-bold text-salon-darkblue">{item.service.price}</span>
                <span class="text-gray-600">{item.service.duration}</span>
              </div>
              <p class="text-gray-700 mb-6">{item.description}</p>
              <a
                href={`/services/${item.service.slug}/`}
                class="inline-flex items-center text-salon-darkblue font-medium hover:text-[#0F7A9C] transition-colors"
              >
                {item.service.name}
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          ))}
        </div>

        <p class="text-center text-gray-700 mt-10">
          Ready to get started? <a href="/booking/" class="text-salon-darkblue font-semibold underline hover:text-[#0F7A9C] transition-colors">book online</a> or see the <a href={business.googleReviewUrl} class="text-salon-darkblue font-semibold underline hover:text-[#0F7A9C] transition-colors" target="_blank" rel="noopener noreferrer">Google listing</a> for directions.
        </p>
      </div>
    </div>
  </section>

  <!-- Travel information -->
  <section class="py-16 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold mb-8">Getting here from Kumeū</h2>

        <div class="bg-gray-50 rounded-lg shadow-md p-6">
          <div class="space-y-3">
            <div class="flex justify-between">
              <span class="font-medium">Approximate drive time:</span>
              <span>About 25 minutes</span>
            </div>
            <div class="flex justify-between">
              <span class="font-medium">Route:</span>
              <span>SH16 north through Waimauku to Kaukapakapa</span>
            </div>
            <div class="flex justify-between">
              <span class="font-medium">Parking:</span>
              <span>Free on-site parking</span>
            </div>
            <div class="flex justify-between">
              <span class="font-medium">Address:</span>
              <span>{business.addressLine}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-gradient-to-br from-[#1EAEDB] to-[#0891B2] text-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl font-bold mb-6">Book your Kaukapakapa appointment</h2>
        <p class="text-xl mb-8">
          Balayage, keratin, colour and cuts, about 25 minutes up SH16 from Kumeū. Free parking, one stylist, no rush.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/booking/" class="bg-white text-salon-darkblue font-semibold py-3 px-8 rounded-md hover:bg-gray-100 transition inline-flex items-center justify-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            Book Your Appointment
          </a>
          <a href="/contact/" class="bg-transparent border-2 border-white text-white font-semibold py-3 px-8 rounded-md hover:bg-white hover:text-salon-darkblue transition">
            Get Directions & Contact Info
          </a>
        </div>

        <div class="mt-8 text-center">
          <p class="text-lg">
            About 25 minutes from Kumeū via SH16 · Call <a href={business.phoneHref} class="underline hover:no-underline">{business.phoneDisplay}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section (single source of visible FAQ + FAQPage JSON-LD) -->
  <FAQSchema
    faqs={faqs}
    pageUrl="https://hairbymelissa.co.nz/locations/kumeu"
  />
</Layout>
