---
import Layout from '../layouts/Layout.astro';
import { business } from '../data/business';
import { services, getService } from '../data/services';

const pageTitle = "Hairdressing Services & Prices, Kaukapakapa";
const pageDescription = "Hairdressing in Kaukapakapa from $40 — cuts, colour, balayage and keratin at Melissa's home salon. Book online or call today.";
const pageKeywords = "hair dressing, hairdressing kaukapakapa, hairdressing prices, hair styling techniques, hair coloring methods, hair treatments, hair care guide, salon services north auckland";

// Comprehensive sections for pillar content
const hairDressingTopics = [
  {
    id: "cutting-techniques",
    title: "Hair Cutting Techniques",
    icon: "scissors",
    description: "Master the art of precision cutting",
    subtopics: ["Layer Cutting", "Graduation", "Texturizing", "Point Cutting", "Razor Cutting"]
  },
  {
    id: "coloring-methods",
    title: "Hair Coloring Methods",
    icon: "palette",
    description: "Explore modern coloring techniques",
    subtopics: ["Balayage", "Highlights", "Color Correction", "Fashion Colors", "Grey Coverage"]
  },
  {
    id: "styling-treatments",
    title: "Styling & Treatments",
    icon: "sparkles",
    description: "Transform hair with treatments",
    subtopics: ["Keratin Treatments", "Deep Conditioning", "Scalp Treatments", "Hair Botox", "Olaplex"]
  },
  {
    id: "hair-care",
    title: "Professional Hair Care",
    icon: "heart",
    description: "Maintain healthy, beautiful hair",
    subtopics: ["Daily Care", "Product Selection", "Damage Prevention", "Home Maintenance", "Seasonal Care"]
  }
];

// FAQ Schema for voice search optimization
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is professional hair dressing?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Professional hair dressing encompasses the art and science of cutting, coloring, styling, and treating hair. It combines technical expertise with creative vision to enhance appearance and maintain hair health."
      }
    },
    {
      "@type": "Question",
      "name": "How often should I visit a hair dresser?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most people should visit a hair dresser every 6-8 weeks for maintenance. However, this varies based on hair type, style, and whether you have color treatments that need touching up every 4-6 weeks."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between hair dressing and hair styling?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hair dressing is the broader profession encompassing cutting, coloring, and chemical treatments, while hair styling specifically refers to arranging hair into a particular look using tools and products."
      }
    }
  ]
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://hairbymelissa.co.nz"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Hairdressing Services & Prices",
      "item": "https://hairbymelissa.co.nz/hair-dressing"
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  pageType="article"
>
  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[#D3E4FD] via-white to-[#FFDEE2] opacity-90"></div>
    <div class="absolute top-20 right-10 w-96 h-96 bg-gradient-to-br from-[#1EAEDB]/10 to-[#FFDEE2]/20 rounded-full morph-blob blur-3xl"></div>

    <div class="container-custom relative z-10">
      <nav class="mb-6">
        <ol class="flex items-center space-x-2 text-sm">
          <li><a href="/" class="text-gray-600 hover:text-salon-darkblue">Home</a></li>
          <li class="text-gray-400">/</li>
          <li class="text-gray-900 font-medium">Hairdressing Services & Prices</li>
        </ol>
      </nav>

      <div class="max-w-4xl">
        <h1 class="text-5xl md:text-6xl font-bold leading-tight mb-6">
          Hairdressing services & prices, <span class="gradient-text">Kaukapakapa</span>
        </h1>
        <p class="text-xl text-gray-700 mb-8">
          Hair By Melissa is a home salon in Kaukapakapa, serving Helensville, Wainui, Waitoki and Kumeū. Cuts, colour, balayage and keratin treatments from $40, with real prices below and one stylist for every appointment.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a href="/booking/" class="btn-primary inline-flex items-center justify-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            Book online
          </a>
          <a href={business.phoneHref} class="bg-transparent border-2 border-gray-900 text-gray-900 font-medium py-3 px-6 rounded-md hover:bg-gray-900 hover:text-white transition duration-300 ease-in-out inline-flex items-center justify-center">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            Call {business.phoneDisplay}
          </a>
        </div>

        <!-- Quick Navigation -->
        <div class="flex flex-wrap gap-4">
          <a href="#prices" class="inline-flex items-center px-4 py-2 bg-white rounded-full shadow-md hover:shadow-lg transition">
            <svg class="w-5 h-5 mr-2 text-salon-darkblue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            Prices
          </a>
          <a href="#cutting-techniques" class="inline-flex items-center px-4 py-2 bg-white rounded-full shadow-md hover:shadow-lg transition">
            <svg class="w-5 h-5 mr-2 text-salon-darkblue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"></path>
            </svg>
            Cutting
          </a>
          <a href="#coloring-methods" class="inline-flex items-center px-4 py-2 bg-white rounded-full shadow-md hover:shadow-lg transition">
            <svg class="w-5 h-5 mr-2 text-salon-darkblue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
            </svg>
            Coloring
          </a>
          <a href="#styling-treatments" class="inline-flex items-center px-4 py-2 bg-white rounded-full shadow-md hover:shadow-lg transition">
            <svg class="w-5 h-5 mr-2 text-salon-darkblue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
            </svg>
            Treatments
          </a>
          <a href="#hair-care" class="inline-flex items-center px-4 py-2 bg-white rounded-full shadow-md hover:shadow-lg transition">
            <svg class="w-5 h-5 mr-2 text-salon-darkblue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            </svg>
            Hair Care
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Introduction Section -->
  <section class="py-16 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-6">Hairdressing at Melissa's home salon</h2>
        <div class="prose prose-lg max-w-none text-gray-700">
          <p>
            Hair By Melissa is a home salon on Magnolia Lane in Kaukapakapa, offering the full range of professional hairdressing: cutting, colouring, balayage and keratin treatments, all performed by Melissa personally. It's a quiet, one-on-one setting with free parking at the door — no double-booking, no rush.
          </p>
          <p>
            The salon serves Kaukapakapa and the surrounding North Auckland towns — Helensville, Wainui, Waitoki and Kumeū — with clients travelling in for an appointment rather than dropping into a shopfront. Every price on this page comes straight from our current service list, so there are no surprises when you book.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services & Prices -->
  <section id="prices" class="py-16 bg-gray-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold mb-4 text-center">Hairdressing services & prices</h2>
        <p class="text-xl text-gray-600 text-center mb-12">
          Every service we offer, with the price and duration you'll be booked in for.
        </p>

        <div class="bg-white rounded-lg shadow-lg divide-y divide-gray-100 overflow-hidden">
          {services.map((service) => (
            <a
              href={`/services/${service.slug}/`}
              class="flex items-center justify-between gap-4 px-6 py-4 hover:bg-gray-50 transition-colors"
            >
              <div>
                <span class="font-semibold text-gray-900">{service.name}</span>
                <span class="block text-sm text-gray-500">{service.duration}</span>
              </div>
              <span class="text-xl font-bold text-salon-darkblue whitespace-nowrap">{service.price}</span>
            </a>
          ))}
        </div>

        <p class="text-center text-gray-700 mt-10">
          Ready to book? <a href="/booking/" class="text-salon-darkblue font-semibold underline hover:text-[#0F7A9C] transition-colors">book online</a> or call <a href={business.phoneHref} class="text-salon-darkblue font-semibold underline hover:text-[#0F7A9C] transition-colors">{business.phoneDisplay}</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Topics Grid -->
  <section class="py-16 bg-white">
    <div class="container-custom">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold mb-4">Core Areas of Hair Dressing</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          A short guide to the technical skills behind every appointment.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {hairDressingTopics.map((topic) => (
          <div class="bg-gray-50 rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
            <div class="p-8">
              <div class="flex items-start mb-4">
                {topic.icon === "scissors" && (
                  <svg class="w-8 h-8 text-salon-darkblue mr-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z"></path>
                  </svg>
                )}
                {topic.icon === "palette" && (
                  <svg class="w-8 h-8 text-salon-darkblue mr-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
                  </svg>
                )}
                {topic.icon === "sparkles" && (
                  <svg class="w-8 h-8 text-salon-darkblue mr-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                  </svg>
                )}
                {topic.icon === "heart" && (
                  <svg class="w-8 h-8 text-salon-darkblue mr-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                  </svg>
                )}
                <div>
                  <h3 class="text-2xl font-bold mb-2">{topic.title}</h3>
                  <p class="text-gray-600 mb-4">{topic.description}</p>
                </div>
              </div>
              <div class="space-y-2">
                {topic.subtopics.map((subtopic) => (
                  <div class="flex items-center text-gray-700">
                    <svg class="w-4 h-4 text-salon-darkblue mr-2" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    <span>{subtopic}</span>
                  </div>
                ))}
              </div>
              <a href={`#${topic.id}`} class="inline-flex items-center mt-6 text-salon-darkblue font-medium hover:underline"
                 aria-label={`Learn more about ${topic.title}`}>
                Learn more about {topic.title}
                <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Cutting Techniques Section -->
  <section id="cutting-techniques" class="py-16 bg-gray-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-6">Hair Cutting Techniques</h2>

        <div class="prose prose-lg max-w-none">
          <p class="text-gray-700 mb-6">
            Cutting is the foundation of hairdressing — precision, an understanding of growth patterns, and an eye for what suits your face shape and lifestyle.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="bg-white p-5 rounded-lg">
              <h4 class="text-lg font-semibold mb-1">Layer Cutting</h4>
              <p class="text-gray-700 text-sm">Movement and volume by cutting hair at different lengths.</p>
            </div>
            <div class="bg-white p-5 rounded-lg">
              <h4 class="text-lg font-semibold mb-1">Graduation</h4>
              <p class="text-gray-700 text-sm">Builds weight and shape, from classic bobs to asymmetrical styles.</p>
            </div>
            <div class="bg-white p-5 rounded-lg">
              <h4 class="text-lg font-semibold mb-1">Texturizing</h4>
              <p class="text-gray-700 text-sm">Removes bulk for modern, lived-in movement.</p>
            </div>
          </div>
        </div>

        <!-- CTA to services -->
        <div class="p-6 bg-gradient-to-r from-[#D3E4FD] to-[#FFDEE2] rounded-lg">
          <h3 class="text-xl font-semibold mb-2">Book a cut at Hair By Melissa</h3>
          <p class="text-gray-700 mb-4">Women's cut & finish is {getService('womens-cut-finish').price}, tailored to your style and features.</p>
          <a href="/services/womens-cut-finish/" class="inline-flex items-center btn-primary">
            Book Your Cut
            <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Coloring Methods Section -->
  <section id="coloring-methods" class="py-16 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-6">Hair Coloring Methods</h2>

        <div class="prose prose-lg max-w-none">
          <p class="text-gray-700 mb-6">
            Colouring is where technique meets result. Melissa uses these methods most, matched to your hair and how much maintenance you want.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div class="bg-gray-50 p-6 rounded-lg">
              <h4 class="text-xl font-semibold mb-2 text-salon-darkblue">Balayage</h4>
              <p class="text-gray-700">Hand-painted highlights creating sun-kissed, natural-looking dimension that grows out softly.</p>
              <p class="mt-2 font-semibold">From {getService('balayage').price}</p>
            </div>

            <div class="bg-gray-50 p-6 rounded-lg">
              <h4 class="text-xl font-semibold mb-2 text-salon-darkblue">Foil Highlights</h4>
              <p class="text-gray-700">Precise placement for maximum lift and contrast.</p>
              <p class="mt-2 font-semibold">From {getService('partial-foils').price}</p>
            </div>

            <div class="bg-gray-50 p-6 rounded-lg">
              <h4 class="text-xl font-semibold mb-2 text-salon-darkblue">All-Over Colour</h4>
              <p class="text-gray-700">Complete colour transformation or grey coverage from roots to ends.</p>
              <p class="mt-2 font-semibold">From {getService('permanent-tint-all-over').price}</p>
            </div>

            <div class="bg-gray-50 p-6 rounded-lg">
              <h4 class="text-xl font-semibold mb-2 text-salon-darkblue">Toner</h4>
              <p class="text-gray-700">Neutralises brassiness and refreshes tone between colour appointments.</p>
              <p class="mt-2 font-semibold">From {getService('toner').price}</p>
            </div>
          </div>
        </div>

        <!-- Link to services -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <a href="/services/balayage/" class="text-center p-4 bg-gray-50 rounded-lg shadow hover:shadow-lg transition">
            <span class="block font-semibold text-salon-darkblue">Balayage</span>
            <span class="text-sm text-gray-600">Learn More →</span>
          </a>
          <a href="/services/full-head-highlights/" class="text-center p-4 bg-gray-50 rounded-lg shadow hover:shadow-lg transition">
            <span class="block font-semibold text-salon-darkblue">Highlights</span>
            <span class="text-sm text-gray-600">Learn More →</span>
          </a>
          <a href="/services/permanent-tint-all-over/" class="text-center p-4 bg-gray-50 rounded-lg shadow hover:shadow-lg transition">
            <span class="block font-semibold text-salon-darkblue">Full Color</span>
            <span class="text-sm text-gray-600">Learn More →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Styling & Treatments Section -->
  <section id="styling-treatments" class="py-16 bg-gray-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-6">Styling & Treatments</h2>

        <div class="prose prose-lg max-w-none">
          <p class="text-gray-700 mb-6">
            Beyond cutting and colour, treatments repair, protect and make styling easier day to day.
          </p>

          <div class="border-l-4 border-salon-darkblue pl-6 mb-6">
            <h4 class="text-xl font-semibold mb-2">Keratin Treatments</h4>
            <p class="text-gray-700 mb-2">Our signature treatment for frizzy, unmanageable hair. Keratin infuses into the hair cuticle for a smoother, shinier finish that's easier to style.</p>
            <a href="/services/keratin-treatments/" class="inline-block mt-1 text-salon-darkblue font-medium hover:underline">
              Explore Keratin Treatment ({getService('keratin-treatments').price}) →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="border-l-4 border-[#FFDEE2] pl-6">
              <h4 class="text-lg font-semibold mb-2">Blow Wave</h4>
              <p class="text-gray-700 text-sm">Professional blow drying for volume and lasting style.</p>
            </div>
            <div class="border-l-4 border-[#D3E4FD] pl-6">
              <h4 class="text-lg font-semibold mb-2">UV Protection Treatment</h4>
              <p class="text-gray-700 text-sm">Protects colour and condition from sun exposure.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Hair Care Section -->
  <section id="hair-care" class="py-16 bg-white">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-6">Professional Hair Care Between Appointments</h2>

        <div class="prose prose-lg max-w-none">
          <p class="text-gray-700 mb-6">
            Good hair care extends beyond the salon chair. A simple routine keeps colour and treatments looking their best.
          </p>

          <div class="bg-gray-50 p-6 rounded-lg">
            <ol class="list-decimal pl-6 space-y-2 text-gray-700">
              <li><strong>Gentle cleansing:</strong> sulfate-free shampoo that cleans without stripping natural oils</li>
              <li><strong>Proper conditioning:</strong> apply from mid-length to ends, avoiding roots</li>
              <li><strong>Heat protection:</strong> always use heat protectant before styling tools</li>
              <li><strong>Regular treatments:</strong> a weekly deep-conditioning mask for colour-treated hair</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-gray-50">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold mb-8 text-center">Frequently Asked Questions About Hair Dressing</h2>

        <div class="space-y-6">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-semibold mb-3">What is professional hair dressing?</h3>
