---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  price: string;
  duration: string;
  image: string;
  h1?: string;
  description?: string;
  keywords?: string;
  imageAlt?: string;
  imageSrcset?: string;
  imageSizes?: string;
  imageWidth?: number;
  imageHeight?: number;
  serviceName?: string;
  ogImage?: string;
  showCta?: boolean;
}

const {
  title,
  price,
  duration,
  image,
  h1,
  description,
  keywords,
  imageAlt,
  imageSrcset,
  imageSizes = '100vw',
  imageWidth = 1600,
  imageHeight = 900,
  serviceName,
  ogImage,
  showCta = true,
} = Astro.props;

const heading = h1 ?? title.split(' | ')[0];
const heroAlt = imageAlt ?? heading;

// Canonical URL, computed the same way Layout.astro does, with a guaranteed
// trailing slash so it always matches the <link rel="canonical"> Layout emits.
const rawPathname = Astro.url.pathname;
const canonicalPathname = rawPathname.endsWith('/') ? rawPathname : `${rawPathname}/`;
const canonicalURL = new URL(canonicalPathname, 'https://hairbymelissa.co.nz').toString();

// Absolute image URL for JSON-LD (ogImage if given, else the hero image).
const jsonLdImage = ogImage
  ? ogImage
  : new URL(image, 'https://hairbymelissa.co.nz').href;

// Parse the first number (allow decimals) out of the price prop, e.g. "$180" -> 180.
const priceMatch = price.match(/[\d,]+(?:\.\d+)?/);
const parsedPrice = priceMatch ? parseFloat(priceMatch[0].replace(/,/g, '')) : NaN;

const serviceSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonicalURL}#service`,
  name: serviceName ?? heading,
  serviceType: serviceName ?? heading,
  description,
  provider: { '@id': 'https://hairbymelissa.co.nz/#business' },
  areaServed: ['Kaukapakapa', 'Helensville', 'Wainui', 'Waitoki', 'Kumeū'].map((name) => ({
    '@type': 'City',
    name,
  })),
  offers: {
    '@type': 'Offer',
    ...(Number.isNaN(parsedPrice) ? {} : { price: parsedPrice }),
    priceCurrency: 'NZD',
    availability: 'https://schema.org/InStock',
    url: canonicalURL,
  },
  image: jsonLdImage,
  url: canonicalURL,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://hairbymelissa.co.nz/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Services',
      item: 'https://hairbymelissa.co.nz/services/',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: heading,
      item: canonicalURL,
    },
  ],
};
---

<Layout title={title} description={description} keywords={keywords} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <!-- Background Layer -->
    <img
      src={image}
      alt={heroAlt}
      width={imageWidth}
      height={imageHeight}
      fetchpriority="high"
      loading="eager"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-center"
      {...(imageSrcset ? { srcset: imageSrcset, sizes: imageSizes } : {})}
    />

    <!-- Dark Overlay -->
    <div class="absolute inset-0 bg-black/60"></div>

    <div class="container-custom relative z-10">
      <div class="max-w-2xl">
        <h1 class="text-5xl font-bold text-white leading-tight">
          {heading}
        </h1>
      </div>
    </div>
  </section>

  <!-- Service Content -->
  <section class="bg-white py-16">
    <div class="container-custom">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <!-- Main Content -->
          <div class="lg:col-span-2">
            <slot />
          </div>

          <!-- Service Info Box -->
          <div class="lg:col-span-1">
            <div class="bg-[#F8F9FA] rounded-lg p-8 sticky top-32">
              <h3 class="text-2xl font-bold mb-6">Service Details</h3>

              <div class="space-y-4 mb-8">
                <div>
                  <p class="text-gray-600 text-sm uppercase tracking-wide">Price</p>
                  <p class="text-3xl font-bold text-salon-darkblue">{price}</p>
                </div>

                <div>
                  <p class="text-gray-600 text-sm uppercase tracking-wide">Duration</p>
                  <p class="text-xl font-semibold">{duration}</p>
                </div>
              </div>

              <a href="/booking/" class="btn-primary w-full text-center inline-block">
                Book This Service
              </a>

              <div class="mt-6 pt-6 border-t border-gray-200">
                <p class="text-sm text-gray-600">
                  Ready to transform your hair? Book your appointment with Melissa today.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <slot name="after" />

  <!-- CTA Section -->
  {showCta && (
    <section class="bg-[#D3E4FD] bg-opacity-20 py-16">
      <div class="container-custom">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-3xl font-bold mb-4">Questions About This Service?</h2>
          <p class="text-gray-700 mb-8">
            Contact Melissa to discuss your hair goals and find the perfect service for you.
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href="/contact/" class="btn-secondary">
              Get in Touch
            </a>
            <a href="/services/" class="bg-white text-gray-800 font-medium py-3 px-6 rounded-md hover:bg-gray-100 transition duration-300 ease-in-out">
              View All Services
            </a>
          </div>
        </div>
      </div>
    </section>
  )}
</Layout>
